# PRAVAH — Environment Variables
# Copy to .env and fill in values

# Optional: Hugging Face token for gated models (not required for MVP)
# HF_TOKEN=

# Database path (default: data/pravah.db)
# DB_PATH=data/pravah.db

# Streamlit server port (default: 8501)
# STREAMLIT_SERVER_PORT=8501

# FastAPI Backend URL (default: http://localhost:8000)
# PRAVAH_API_URL=http://localhost:8000
